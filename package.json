{
	"name": "@klexik/templit",
	"version": "0.0.2",
	"description": "Templating tool based on git repositories",
	"author": "Stepan Martinek",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/martinek-stepan/tempit"
	},
	"homepage": "https://github.com/martinek-stepan/tempit",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"templit": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc -b",
		"publish:npm": "tsc && npm publish --access public",
		"debug": "tsx ./src/index.ts",
		"format": "biome check --apply ./src",
		"lint:ci": "biome ci ./src"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"glob": "11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.4.1",
		"@types/node": "20.x.x",
		"tsx": "4.19.0",
		"typescript": "5.6.2"
	},
	"packageManager": "yarn@4.0.0"
}
